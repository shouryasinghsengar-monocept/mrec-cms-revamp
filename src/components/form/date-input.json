{
  "collectionName": "components_form_date_inputs",
  "info": {
    "displayName": "dateInput",
    "icon": "calendar"
  },
  "options": {},
  "attributes": {
    "field_name": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::field-name.field-name"
    },
    "placeholder": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "required": true
    },
    "hint": {
      "type": "string"
    },
    "required": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "disabled": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "type": {
      "type": "string",
      "default": "simple",
      "required": true
    },
    "minYear": {
      "type": "biginteger",
      "required": true,
      "default": "1926"
    },
    "maxYear": {
      "type": "biginteger",
      "required": true,
      "default": "2040"
    },
    "variant": {
      "type": "string",
      "default": "default",
      "required": true
    },
    "closeIcon": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "showHeader": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "showFooterBtns": {
      "type": "boolean",
      "required": true,
      "default": true
    }
  },
  "config": {}
}
