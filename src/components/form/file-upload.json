{
  "collectionName": "components_form_file_uploads",
  "info": {
    "displayName": "fileUpload",
    "icon": "attachment"
  },
  "options": {},
  "attributes": {
    "field_name": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::field-name.field-name"
    },
    "hint": {
      "type": "string"
    },
    "required": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "label": {
      "type": "string",
      "default": "Label",
      "required": true
    },
    "disabled": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "description": {
      "type": "text"
    },
    "state": {
      "type": "string",
      "default": "default",
      "required": true
    },
    "allowedFileSize": {
      "type": "integer",
      "required": true,
      "default": 1
    },
    "fileFormat": {
      "type": "text",
      "default": "application/pdf,image/jpeg,image/png,image/heic,image/heif",
      "required": true
    },
    "fileNumberLimit": {
      "type": "integer",
      "required": true,
      "default": 1
    }
  },
  "config": {}
}
